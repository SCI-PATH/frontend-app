# Copy to .env.local. Next.js rewrites these at runtime.
# Local Docker defaults:
API_PROXY_TARGET=http://127.0.0.1:8000
USER_API_PROXY_TARGET=http://127.0.0.1:8001
GAMING_API_PROXY_TARGET=http://127.0.0.1:8002
ASSESSMENT_API_PROXY_TARGET=http://127.0.0.1:8004
NEXT_PUBLIC_API_URL=http://127.0.0.1:8003

# Farm Phaser UI (Vite on :5173). Backend still uses GAMING_API_PROXY_TARGET.
NEXT_PUBLIC_GAMING_SERVICE_URL=http://localhost:5173

# Optional: browser talks to IAE directly (needs CORS). Leave unset to use /assessment-api rewrite.
# NEXT_PUBLIC_IAE_API_BASE=http://127.0.0.1:8004
